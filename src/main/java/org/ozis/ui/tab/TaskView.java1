        taskLogScroll.setFitToWidth(true);
        taskLogScroll.setVbarPolicy(ScrollPane.ScrollBarPolicy.AS_NEEDED);
        taskLogScroll.setHbarPolicy(ScrollPane.ScrollBarPolicy.NEVER);
    
        root.setHgap(10);
        root.setVgap(10);
        root.setPadding(new Insets(20));
    
